# Copy to .env.local and fill in. Never commit real values.

# ---- Site ----
# Public origin once the domain is known, e.g. https://example.in (no trailing slash).
SITE_URL=
# Only set to "true" at launch. While not "true", every page is noindex and robots.txt disallows all.
SITE_INDEXING=false

# ---- Business details (leave empty until the owner confirms; empty values are never shown publicly) ----
NEXT_PUBLIC_BUSINESS_PHONE=            # 10-digit Indian mobile or landline digits, e.g. 98XXXXXXXX
NEXT_PUBLIC_BUSINESS_WHATSAPP=         # 10-digit number, digits only
NEXT_PUBLIC_BUSINESS_ADDRESS_EN=
NEXT_PUBLIC_BUSINESS_ADDRESS_TA=
NEXT_PUBLIC_BUSINESS_HOURS_EN=         # e.g. Mon–Sat, 10:00–18:00
NEXT_PUBLIC_BUSINESS_HOURS_TA=
NEXT_PUBLIC_MAP_LINK=                  # Google Maps share link of the real office
NEXT_PUBLIC_MAP_EMBED_URL=             # Google Maps "Embed a map" src URL
# Set to "direct" or "partner" only after the owner confirms how loans are provided. Empty = not stated on site.
NEXT_PUBLIC_LENDING_MODEL=

# ---- Live enquiry storage ----
# "true" tells the site that the database below is configured, backed up, and ready to hold real enquiries.
# While not "true" the assistant works as a PREVIEW and never claims an enquiry was submitted.
LIVE_ENQUIRIES=false
# SQLite file path. Must be on persistent disk (not a serverless/ephemeral filesystem).
DATABASE_PATH=./data/tirukumaran.db
# Random secret (>= 32 chars) used to hash IPs for rate limiting. Generate: openssl rand -hex 32
RATE_LIMIT_SALT=

# ---- Staff accounts ----
# Create staff with: npm run staff:create  (prompts for password; nothing is stored in env)
# Set true only when served over HTTPS (production).
COOKIE_SECURE=false
